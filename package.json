{
  "name": "taz-iptv",
  "productName": "TaZ IPTV",
  "version": "1.0.0",
  "description": "TaZ IPTV - live TV player for Xtream Codes and M3U playlists (desktop port of the Android TV app)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core.test.js test/games.dom.test.js",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.taz.iptv",
    "productName": "TaZ IPTV",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "TaZ-IPTV-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "TaZ-IPTV-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment"
    },
    "dmg": {
      "artifactName": "TaZ-IPTV-${version}-${arch}.${ext}"
    }
  },
  "author": "TaZ"
}
